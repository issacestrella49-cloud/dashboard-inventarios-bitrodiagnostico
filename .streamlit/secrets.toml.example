# Copia este archivo como .streamlit/secrets.toml (mismo folder) y reemplaza la URL
# con tu propia cadena de conexion de Supabase (Project Settings -> Database ->
# Connection string -> pestana "Transaction pooler"). NUNCA subas secrets.toml a GitHub
# (ya esta en .gitignore).
#
# En Streamlit Cloud, esto mismo se pega en: tu app -> Settings -> Secrets.

[connections.db]
url = "postgresql://postgres.xxxxxxxx:TU_PASSWORD@aws-0-region.pooler.supabase.com:6543/postgres"
